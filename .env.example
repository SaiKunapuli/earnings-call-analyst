# Copy to .env (gitignored) and fill in what you use.
# Only needed for the optional LLM Q&A feature extraction
# (scripts/run_llm_extraction.py) — the core pipeline runs without any keys.
# The runner auto-detects: Anthropic > Gemini > local Ollama (no key needed).

# Free tier available at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (best extraction quality)
ANTHROPIC_API_KEY=
