# Copy to .env (gitignored) and fill in what you use.
# Only needed for the optional LLM Q&A feature extraction
# (scripts/run_llm_extraction.py) — the core pipeline runs without any keys.

# Provider selection: explicit LLM_PROVIDER wins; otherwise the runner
# auto-detects Anthropic > Gemini > local Ollama (no key needed).
#   ollama  — free, local, but ~27 days for the full corpus
#   gemini  — free tier ~20 req/day (useless for batch); with BILLING enabled
#             the full 18k corpus is ~$14 and runs in <1 h. Pass --paid.
#   anthropic — highest quality; full corpus ~$150 (Haiku) .. ~$750 (Opus)
LLM_PROVIDER=gemini

# https://aistudio.google.com/apikey — same key works free or billed; enable
# billing in Google AI Studio ("Get API key" -> "Set up billing") to lift the
# free-tier rate cap. Then: scripts/run_llm_extraction.py --paid --pilot 65
GEMINI_API_KEY=

# Optional (best extraction quality). full-corpus cost depends on model.
ANTHROPIC_API_KEY=
