# Virtual environments
venv/
.venv/

# Data files (too large for git)
data/*
!data/snapshots.db    # daily snapshots -- small, committed for GitHub Actions persistence
!data/universe.txt    # full snapshot universe -- so CI covers all ~690 names, not just 57
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/

# Secrets / API keys
.env

# Databases
*.sqlite
*.db

# IDE / tooling
.qodo/
.vscode/
.claude/
.pytest_cache/

# graphify knowledge-graph output (generated artifact — graph.html/json, report)
graphify-out/

# Test scripts
smoke_test_*.py
stress_test_*.py
db_state.py

# Docs (gitignored per user request)
docs/

# tests/ is TRACKED (un-hidden 2026-07-09 — 160+ passing tests are a selling
# point for a portfolio repo; see PROJECT_JOURNAL §5.10)

# scripts/ is tracked (pipeline utilities: analyze_results, monitor_progress,
# run_llm_extraction). One-off throwaway scripts match the patterns above
# (smoke_test_*, stress_test_*) — name them accordingly.

# Legacy pre-rebuild charts (superseded; current charts live in the notebooks)
graphs/legacy/

# models/ is TRACKED (2026-07-09): the §4.11 contamination was unrecoverable
# precisely because model artifacts lived outside git. ~2MB total; every
# artifact is hash-pinned in models/MODEL_MANIFEST.json (scripts/verify_frozen.py).

# OS files
.DS_Store
Thumbs.db
nul
*.pdf

# Executed notebook copies (generated by nbconvert)
notebooks/*_executed.ipynb
notebooks/*_executed_files/