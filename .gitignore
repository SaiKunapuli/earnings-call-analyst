# Virtual environments
venv/
.venv/

# Data files (too large for git)
data/

# Python cache
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/

# Secrets / API keys
.env

# Databases
*.sqlite
*.db
!data/snapshots.db   # daily snapshots — small, committed for GitHub Actions persistence

# IDE / tooling
.qodo/
.vscode/
.claude/
.pytest_cache/

# Test scripts
smoke_test_*.py
stress_test_*.py
db_state.py

# Docs (gitignored per user request)
docs/

# Tests (gitignored per user request)
tests/

# scripts/ is tracked (pipeline utilities: analyze_results, monitor_progress,
# run_llm_extraction). One-off throwaway scripts match the patterns above
# (smoke_test_*, stress_test_*) — name them accordingly.

# Legacy pre-rebuild charts (superseded; current charts live in the notebooks)
graphs/legacy/

# Models (generated by 04_modeling.ipynb)
models/

# OS files
.DS_Store
Thumbs.db
nul

# Executed notebook copies (generated by nbconvert)
notebooks/*_executed.ipynb
notebooks/*_executed_files/